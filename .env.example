# Copy to `.env.local` and fill in what you want enabled.
# Every variable here is OPTIONAL — the app runs with none of them set.
#
# Never commit `.env.local`. It is git-ignored.

# --- Model scoring (optional) ------------------------------------------------
# Without this, scores are deterministic only and the UI says so explicitly
# rather than substituting a neutral value.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Persistence (optional) --------------------------------------------------
# Without this, the audit trail is kept in memory and resets when the server
# restarts. The UI says which store is active.
# Any Postgres URL works — Neon, Supabase, Railway, or a local instance.
# DATABASE_URL=postgresql://user:password@host:5432/signal_desk

# --- On-chain reads (optional) -----------------------------------------------
# Defaults to failing over across three public endpoints. Set this to pin one.
# ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
