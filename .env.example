# Copy to `.env.local` and fill in what you want enabled.
# Every variable here is OPTIONAL — the app runs with none of them set.
#
# Never commit `.env.local`. It is git-ignored.

# --- Model scoring (optional) ------------------------------------------------
# Without either key, scores are deterministic only and the UI says so rather
# than substituting a neutral value.
#
# OpenRouter is preferred when both are set, because its free tier costs
# nothing to run. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the model chain, tried in order until one returns a valid
# analysis. Defaults are chosen by measured reliability on this task — see
# src/lib/score/providers/openrouter.ts
# OPENROUTER_MODELS=nex-agi/nex-n2.5-pro:free,nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free

# Optional: Anthropic instead. https://console.anthropic.com/
# ANTHROPIC_API_KEY=

# Optional: force one provider. "openrouter" | "anthropic".
# Defaults to OpenRouter when its key is present, else Anthropic.
# LLM_PROVIDER=openrouter

# --- Persistence (optional) --------------------------------------------------
# Without this, the audit trail is kept in memory and resets when the server
# restarts. The UI says which store is active.
#
# SUPABASE: Dashboard -> Connect -> "Transaction pooler" (port 6543).
# Use the pooler string for Vercel — a serverless function opening a direct
# connection per invocation will exhaust the database's connection limit.
# Replace [YOUR-PASSWORD] with your database password, and URL-encode it if it
# contains @ : / ? # [ ] or %.
#
# Then create the table: run drizzle/0000_create_runs.sql in the SQL Editor,
# or `npm run db:push`.
#
# Prepared statements are disabled automatically when a pooler URL is detected,
# which PgBouncer in transaction mode requires.
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# --- On-chain reads (optional) -----------------------------------------------
# Defaults to failing over across three public endpoints. Set this to pin one.
# ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
